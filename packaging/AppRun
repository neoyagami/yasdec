#!/usr/bin/env bash
set -euo pipefail

app_dir="${APPDIR:-$(cd "$(dirname "$0")" && pwd)}"

install_user=false
uninstall_user=false
autostart=false
install_uinput=false
remove_uinput=false
management_requested=false
show_help=false
unknown_arguments=()

for argument in "$@"; do
  case "$argument" in
    --install-user) install_user=true; management_requested=true ;;
    --uninstall-user) uninstall_user=true; management_requested=true ;;
    --autostart) autostart=true; management_requested=true ;;
    --install-uinput) install_uinput=true; management_requested=true ;;
    --remove-uinput) remove_uinput=true; management_requested=true ;;
    -h|--help) show_help=true ;;
    *) unknown_arguments+=("$argument") ;;
  esac
done

print_help() {
  cat <<'EOF'
YASDEC — Yet Another Stream Deck Controller

Usage:
  YASDEC-x86_64.AppImage [OPTION...]

Run options:
  (no options)       Open YASDEC normally
  --background       Start minimized to the system tray

User installation:
  --install-user     Install this AppImage for the current user and add it to
                     the desktop application menu
  --autostart        Start YASDEC with the desktop session; use together with
                     --install-user
  --uninstall-user   Remove the user installation, menu entry, and autostart
                     entry; personal configuration is preserved

Virtual keyboard:
  --install-uinput   Install uinput permissions for global and media keys;
                     authentication is requested and a new login is required
  --remove-uinput    Remove the uinput permissions installed by YASDEC;
                     authentication is requested

Help:
  -h, --help         Show this help and exit

Installation options may be combined, for example:
  ./YASDEC-x86_64.AppImage --install-user --autostart --install-uinput

Run the AppImage as your regular desktop user. YASDEC elevates only the small
uinput permission installer when required; do not run the AppImage with sudo.
EOF
}

if [[ "$show_help" == true ]]; then
  print_help
  exit 0
fi

install_uinput_permissions() {
  local mode="$1"
  local desktop_user installer_source installer_temp permission_script status
  desktop_user="$(id -un)"
  installer_source="$app_dir/usr/share/sdeck"
  installer_temp="$(mktemp -d "${TMPDIR:-/tmp}/yasdec-uinput.XXXXXX")"
  install -m 0700 "$installer_source/install-uinput.sh" "$installer_temp/install-uinput.sh"
  install -m 0600 "$installer_source/70-sdeck-uinput.rules" "$installer_temp/70-sdeck-uinput.rules"
  install -m 0600 "$installer_source/sdeck-uinput.conf" "$installer_temp/sdeck-uinput.conf"
  permission_script="$installer_temp/install-uinput.sh"
  local arguments=("$desktop_user")
  if [[ "$mode" == "remove" ]]; then
    arguments=("--remove" "$desktop_user")
  fi
  if command -v pkexec >/dev/null 2>&1; then
    if pkexec /usr/bin/bash "$permission_script" "${arguments[@]}"; then status=0; else status=$?; fi
  else
    if sudo /usr/bin/bash "$permission_script" "${arguments[@]}"; then status=0; else status=$?; fi
  fi
  rm -rf -- "$installer_temp"
  return "$status"
}

if [[ "$management_requested" == true ]]; then
  if (( ${#unknown_arguments[@]} )); then
    echo "Unknown option: ${unknown_arguments[0]}" >&2
    exit 2
  fi
  if [[ "$install_user" == true && "$uninstall_user" == true ]] || \
     [[ "$install_uinput" == true && "$remove_uinput" == true ]]; then
    echo "Install and uninstall options cannot be used together." >&2
    exit 2
  fi
  if [[ "$autostart" == true && "$install_user" != true ]]; then
    echo "--autostart requires --install-user." >&2
    exit 2
  fi
  if [[ "$EUID" -eq 0 ]]; then
    echo "Run the AppImage without sudo; YASDEC elevates only the uinput installer." >&2
    exit 2
  fi

  if [[ "$install_user" == true || "$uninstall_user" == true ]]; then
    mode="install"
    if [[ "$uninstall_user" == true ]]; then
      mode="uninstall"
    fi
    user_arguments=()
    if [[ "$autostart" == true ]]; then
      user_arguments+=("--autostart")
    fi
    if [[ -z "${APPIMAGE:-}" ]] || [[ ! -f "${APPIMAGE:-}" ]]; then
      echo "The original AppImage path is unavailable; run this command from the AppImage itself." >&2
      exit 1
    fi
    /usr/bin/bash "$app_dir/usr/share/sdeck/install-appimage-user.sh" \
      "$mode" "$APPIMAGE" "$app_dir/sdeck.desktop" "$app_dir/sdeck.svg" "${user_arguments[@]}"
  fi

  if [[ "$install_uinput" == true ]]; then
    install_uinput_permissions install
  fi
  if [[ "$remove_uinput" == true ]]; then
    install_uinput_permissions remove
  fi
  exit 0
fi

exec "$app_dir/usr/lib/sdeck/YASDEC" "$@"
