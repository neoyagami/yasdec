#!/usr/bin/env bash
set -euo pipefail

app_dir="${APPDIR:-$(cd "$(dirname "$0")" && pwd)}"

if [[ "${1:-}" == "--install-uinput" ]] || [[ "${1:-}" == "--remove-uinput" ]]; then
  desktop_user="$(id -un)"
  permission_script="$app_dir/usr/share/sdeck/install-uinput.sh"
  arguments=("$desktop_user")
  if [[ "$1" == "--remove-uinput" ]]; then
    arguments=("--remove" "$desktop_user")
  fi
  if command -v pkexec >/dev/null 2>&1; then
    exec pkexec "$permission_script" "${arguments[@]}"
  fi
  exec sudo "$permission_script" "${arguments[@]}"
fi

exec "$app_dir/usr/lib/sdeck/YASDEC" "$@"
