#!/usr/bin/env bash
set -euo pipefail

app_dir="${APPDIR:-$(cd "$(dirname "$0")" && pwd)}"

if [[ "${1:-}" == "--install-user" ]] || [[ "${1:-}" == "--uninstall-user" ]]; then
  if [[ -z "${APPIMAGE:-}" ]] || [[ ! -f "${APPIMAGE:-}" ]]; then
    echo "The original AppImage path is unavailable; run this command from the AppImage itself." >&2
    exit 1
  fi
  mode="install"
  if [[ "$1" == "--uninstall-user" ]]; then
    mode="uninstall"
  fi
  shift
  /usr/bin/bash "$app_dir/usr/share/sdeck/install-appimage-user.sh" \
    "$mode" "$APPIMAGE" "$app_dir/sdeck.desktop" "$app_dir/sdeck.svg" "$@"
  exit $?
fi

if [[ "${1:-}" == "--install-uinput" ]] || [[ "${1:-}" == "--remove-uinput" ]]; then
  if [[ "${EUID}" -eq 0 ]]; then
    echo "Run the AppImage without sudo; YASDEC will request permission only for the uinput installer." >&2
    exit 2
  fi
  desktop_user="$(id -un)"
  installer_source="$app_dir/usr/share/sdeck"
  installer_temp="$(mktemp -d "${TMPDIR:-/tmp}/yasdec-uinput.XXXXXX")"
  cleanup_installer() {
    rm -rf -- "$installer_temp"
  }
  trap cleanup_installer EXIT
  install -m 0700 "$installer_source/install-uinput.sh" "$installer_temp/install-uinput.sh"
  install -m 0600 "$installer_source/70-sdeck-uinput.rules" "$installer_temp/70-sdeck-uinput.rules"
  install -m 0600 "$installer_source/sdeck-uinput.conf" "$installer_temp/sdeck-uinput.conf"
  permission_script="$installer_temp/install-uinput.sh"
  arguments=("$desktop_user")
  if [[ "$1" == "--remove-uinput" ]]; then
    arguments=("--remove" "$desktop_user")
  fi
  if command -v pkexec >/dev/null 2>&1; then
    pkexec /usr/bin/bash "$permission_script" "${arguments[@]}"
    exit $?
  fi
  sudo /usr/bin/bash "$permission_script" "${arguments[@]}"
  exit $?
fi

exec "$app_dir/usr/lib/sdeck/YASDEC" "$@"
